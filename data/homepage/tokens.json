{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Slick sharp black glass with a red accent for a self-hosted homelab. Near-black canvas, red accent, frosted glass cards, sharp square tiles, tight spacing.",
  "color": {
    "$type": "color",
    "primary": { "$value": { "colorSpace": "srgb", "components": [0.961, 0.961, 0.961], "hex": "#f5f5f5" } },
    "secondary": { "$value": { "colorSpace": "srgb", "components": [0.631, 0.631, 0.667], "hex": "#a1a1aa" } },
    "tertiary": { "$value": { "colorSpace": "srgb", "components": [0.937, 0.267, 0.267], "hex": "#ef4444" } },
    "neutral": { "$value": { "colorSpace": "srgb", "components": [0.0, 0.0, 0.0], "hex": "#000000" } },
    "on-tertiary": { "$value": { "colorSpace": "srgb", "components": [0.039, 0.039, 0.047], "hex": "#0a0a0c" } },
    "accent": { "$value": { "colorSpace": "srgb", "components": [0.937, 0.267, 0.267], "hex": "#ef4444" } },
    "glass": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.06, "hex": "#ffffff" } },
    "glass-border": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.12, "hex": "#ffffff" } }
  },
  "spacing": {
    "$type": "dimension",
    "sm": { "$value": { "value": 6, "unit": "px" } },
    "md": { "$value": { "value": 10, "unit": "px" } },
    "lg": { "$value": { "value": 14, "unit": "px" } },
    "xl": { "$value": { "value": 20, "unit": "px" } }
  },
  "rounded": {
    "$type": "dimension",
    "md": { "$value": { "value": 0, "unit": "px" } },
    "lg": { "$value": { "value": 0, "unit": "px" } }
  },
  "typography": {
    "body-md": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 1, "unit": "rem" } }
    },
    "h2": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 1.0625, "unit": "rem" }, "fontWeight": 600 }
    },
    "label-caps": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 0.7, "unit": "rem" }, "fontWeight": 600, "letterSpacing": { "value": 0.08, "unit": "em" } }
    }
  }
}
