{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Vivid glassmorphism launcher for a self-hosted homelab. Deep violet canvas, vivid accent glows (violet/magenta/cyan), glassy translucent cards, dense rounded tile grid.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": { "colorSpace": "srgb", "components": [0.945, 0.961, 0.976], "hex": "#f1f5f9" }
    },
    "secondary": {
      "$value": { "colorSpace": "srgb", "components": [0.647, 0.706, 0.988], "hex": "#a5b4fc" }
    },
    "tertiary": {
      "$value": { "colorSpace": "srgb", "components": [0.133, 0.827, 0.933], "hex": "#22d3ee" }
    },
    "neutral": {
      "$value": { "colorSpace": "srgb", "components": [0.071, 0.031, 0.122], "hex": "#12081f" }
    },
    "on-tertiary": {
      "$value": { "colorSpace": "srgb", "components": [0.043, 0.024, 0.09], "hex": "#0b0617" }
    },
    "accent": {
      "$value": { "colorSpace": "srgb", "components": [0.655, 0.545, 0.98], "hex": "#a78bfa" }
    },
    "glass": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.06, "hex": "#ffffff" }
    },
    "glass-border": {
      "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.14, "hex": "#ffffff" }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": { "$value": { "value": 8, "unit": "px" } },
    "md": { "$value": { "value": 16, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } },
    "xl": { "$value": { "value": 40, "unit": "px" } }
  },
  "rounded": {
    "$type": "dimension",
    "md": { "$value": { "value": 20, "unit": "px" } },
    "lg": { "$value": { "value": 24, "unit": "px" } }
  },
  "typography": {
    "body-md": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 1, "unit": "rem" } }
    },
    "h2": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 1.125, "unit": "rem" }, "fontWeight": 700 }
    },
    "label-caps": {
      "$type": "typography",
      "$value": { "fontFamily": "Inter, system-ui, sans-serif", "fontSize": { "value": 0.75, "unit": "rem" }, "fontWeight": 600, "letterSpacing": { "value": 0.08, "unit": "em" } }
    }
  }
}
