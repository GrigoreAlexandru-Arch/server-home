{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$description": "Clean, calm dark-mode launcher for a self-hosted homelab. Deep navy canvas, teal accent, airy spacing.",
  "color": {
    "$type": "color",
    "primary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.886,
          0.91,
          0.941
        ],
        "hex": "#e2e8f0"
      }
    },
    "secondary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.58,
          0.639,
          0.722
        ],
        "hex": "#94a3b8"
      }
    },
    "tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.176,
          0.831,
          0.749
        ],
        "hex": "#2dd4bf"
      }
    },
    "neutral": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.055,
          0.09,
          0.149
        ],
        "hex": "#0e1726"
      }
    },
    "on-tertiary": {
      "$value": {
        "colorSpace": "srgb",
        "components": [
          0.016,
          0.137,
          0.118
        ],
        "hex": "#04231e"
      }
    }
  },
  "spacing": {
    "$type": "dimension",
    "sm": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "md": {
      "$value": {
        "value": 16,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 24,
        "unit": "px"
      }
    },
    "xl": {
      "$value": {
        "value": 40,
        "unit": "px"
      }
    }
  },
  "rounded": {
    "$type": "dimension",
    "md": {
      "$value": {
        "value": 14,
        "unit": "px"
      }
    },
    "lg": {
      "$value": {
        "value": 20,
        "unit": "px"
      }
    }
  },
  "typography": {
    "body-md": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, system-ui, sans-serif",
        "fontSize": {
          "value": 1,
          "unit": "rem"
        }
      }
    },
    "h2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, system-ui, sans-serif",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    },
    "label-caps": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Inter, system-ui, sans-serif",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600,
        "letterSpacing": {
          "value": 0.08,
          "unit": "em"
        }
      }
    }
  }
}
