// ─────────────────────────────────────────────────────────────────────────────
// Grafana Alloy — the single collector for server.home observability.
//   • Agent telemetry (Hermes) arrives over OTLP and fans out to the 3 stores.
//   • Infrastructure: host metrics, per-container metrics, container logs.
// No tail sampling — everything is stored, filtered at query time.
// ─────────────────────────────────────────────────────────────────────────────

// ── Agent telemetry (OTLP from hermes_otel) → Victoria stores ────────────────
otelcol.receiver.otlp "hermes" {
  grpc {
    endpoint = "0.0.0.0:4317"
  }
  http {
    endpoint = "0.0.0.0:4318"
  }
  output {
    traces  = [otelcol.exporter.otlphttp.victoria_traces.input]
    metrics = [otelcol.exporter.otlphttp.victoria_metrics.input]
    logs    = [otelcol.exporter.otlphttp.victoria_logs.input]
  }
}

otelcol.exporter.otlphttp "victoria_traces" {
  client {
    endpoint = "http://victoria-traces:10428/insert/opentelemetry"
  }
}

otelcol.exporter.otlphttp "victoria_metrics" {
  client {
    endpoint = "http://victoria-metrics:8428/opentelemetry"
  }
}

otelcol.exporter.otlphttp "victoria_logs" {
  client {
    endpoint = "http://victoria-logs:9428/insert/opentelemetry"
  }
}

// ── Host metrics (embedded node_exporter) → VictoriaMetrics ──────────────────
// Host /proc, /sys and / are bind-mounted read-only into the container.
prometheus.exporter.unix "host" {
  procfs_path = "/host/proc"
  sysfs_path  = "/host/sys"
  rootfs_path = "/rootfs"
  // thermal_zone is off by default; needed for SoC temperature on the RK3588.
  enable_collectors = ["thermal_zone"]
}

prometheus.scrape "host" {
  targets         = prometheus.exporter.unix.host.targets
  forward_to      = [prometheus.remote_write.vm.receiver]
  scrape_interval = "30s"
}

// ── Per-container metrics (cAdvisor) → VictoriaMetrics ───────────────────────
// Replaces Dozzle's per-container CPU/mem graphs.
//
// `disk` (container_fs_* filesystem-usage) is DISABLED: cAdvisor computes it by
// walking each container's whole layer tree under the HDD data-root, which cost
// ~300MiB of dentry/inode slab cache + CPU on every housekeeping tick — the
// dominant consumer of Alloy's memory budget. Host filesystem metrics come from
// prometheus.exporter.unix (node_filesystem_*); blkio `diskIO` counters are kept.
// `disabled_metrics` OVERRIDES cAdvisor's defaults, so the default set is listed too.
prometheus.exporter.cadvisor "containers" {
  docker_only               = true
  disable_root_cgroup_stats = true
  disabled_metrics = [
    "advtcp", "cpu_topology", "cpuset", "hugetlb", "memory_numa", "process",
    "referenced_memory", "resctrl", "sched", "tcp", "udp", "disk",
  ]
}

prometheus.scrape "containers" {
  targets         = prometheus.exporter.cadvisor.containers.targets
  forward_to      = [prometheus.remote_write.vm.receiver]
  scrape_interval = "30s"
}

prometheus.remote_write "vm" {
  endpoint {
    url = "http://victoria-metrics:8428/api/v1/write"
  }
}

// ── Container logs (Docker socket) → VictoriaLogs ────────────────────────────
// Replaces Dozzle entirely.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Expose the container name as a real label. loki.source.docker's own `labels`
// map only takes static values, so this goes through a relabel rule over the
// Docker target meta labels. The rule strips the leading slash Docker puts on
// the name. Result: container_name="grafana" etc. on every entry.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets

  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/?(.*)"
    target_label  = "container_name"
  }
}

loki.source.docker "containers" {
  host          = "unix:///var/run/docker.sock"
  targets       = discovery.docker.containers.targets
  relabel_rules = discovery.relabel.containers.rules
  forward_to    = [loki.process.containers.receiver]
}

// Parse container log lines at ingest. Parsed values are attached as structured
// metadata, which VictoriaLogs stores as ordinary log fields, so they are
// directly queryable (e.g. level:error, container_name:pihole).
// Malformed lines are never dropped: stage.json defaults to drop_malformed=false
// and both parsers are guarded by a line filter.
loki.process "containers" {
  forward_to = [loki.write.vl.receiver]

  // Strip ANSI colour codes first — nginx-proxy lines carry them.
  stage.decolorize {}

  // logfmt emitters, e.g. Grafana / Alloy: logger=... level=info msg="..."
  stage.match {
    selector = "{container_name=~\".+\"} |~ \"^[A-Za-z_][A-Za-z0-9_.-]*=\""
    stage.logfmt {
      regex = ".*"
    }
    stage.structured_metadata {
      regex = ".*"
    }
  }

  // JSON emitters: every top-level key becomes a field.
  stage.match {
    selector = "{container_name=~\".+\"} |~ \"^{\""
    stage.json {
      regex = ".*"
    }
    stage.structured_metadata {
      regex = ".*"
    }
  }
}

loki.write "vl" {
  endpoint {
    url = "http://victoria-logs:9428/insert/loki/api/v1/push"
  }
}
